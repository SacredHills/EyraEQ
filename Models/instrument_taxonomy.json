{
  "version": 1,
  "description": "Maps classifier labels (AudioSet class names, as used by YAMNet) to EyraEQ instrument categories. Read by the plug-in and by Scripts/models/validate_nsynth.py, so both use identical logic.",
  "decision": {
    "minActiveSeconds": 3.0,
    "presentScore": 0.12,
    "confidentScore": 0.30,
    "highConfidenceScore": 0.50,
    "dominanceRatio": 1.6,
    "highDominanceRatio": 2.5,
    "candidateRatio": 0.5,
    "maxCandidates": 3
  },
  "categories": [
    { "id": "kick",            "name": "Kick drum",           "classes": { "Bass drum": 1.0 } },
    { "id": "snare",           "name": "Snare drum",          "classes": { "Snare drum": 1.0, "Rimshot": 0.9, "Drum roll": 0.6 } },
    { "id": "toms",            "name": "Toms",                "classes": { "Drum": 0.8, "Timpani": 0.6 } },
    { "id": "cymbals",         "name": "Cymbals",             "classes": { "Cymbal": 1.0, "Hi-hat": 1.0, "Gong": 0.6 } },
    { "id": "overheads",       "name": "Overheads / drum kit","classes": { "Drum kit": 1.0, "Drum machine": 0.5 } },
    { "id": "percussion",      "name": "Percussion",          "classes": { "Tambourine": 1.0, "Maraca": 1.0, "Rattle (instrument)": 0.9, "Wood block": 1.0, "Cowbell": 1.0, "Tabla": 0.9, "Mallet percussion": 0.8, "Marimba, xylophone": 0.8, "Glockenspiel": 0.8, "Vibraphone": 0.8, "Steelpan": 0.8, "Tubular bells": 0.7 } },
    { "id": "electric_bass",   "name": "Electric bass",       "classes": { "Bass guitar": 1.0 } },
    { "id": "acoustic_bass",   "name": "Acoustic bass",       "classes": { "Double bass": 1.0 } },
    { "id": "electric_guitar", "name": "Electric guitar",     "classes": { "Electric guitar": 1.0, "Guitar": 0.6, "Steel guitar, slide guitar": 0.5, "Tapping (guitar technique)": 0.6 } },
    { "id": "acoustic_guitar", "name": "Acoustic guitar",     "classes": { "Acoustic guitar": 1.0, "Guitar": 0.6, "Steel guitar, slide guitar": 0.6 } },
    { "id": "vocal",           "name": "Vocal",               "classes": { "Singing": 1.0, "Vocal music": 0.7, "Choir": 0.8, "Child singing": 0.8, "Synthetic singing": 0.8, "Chant": 0.7, "Yodeling": 0.7, "Rapping": 0.8, "Humming": 0.7, "Speech": 0.6 } },
    { "id": "piano",           "name": "Piano",               "classes": { "Piano": 1.0, "Electric piano": 0.9, "Keyboard (musical)": 0.6, "Harpsichord": 0.6 } },
    { "id": "organ",           "name": "Organ",               "classes": { "Organ": 1.0, "Electronic organ": 1.0, "Hammond organ": 1.0 } },
    { "id": "synth",           "name": "Synthesizer",         "classes": { "Synthesizer": 1.0, "Sampler": 0.6 } },
    { "id": "strings",         "name": "Strings",             "classes": { "Bowed string instrument": 1.0, "String section": 1.0, "Violin, fiddle": 1.0, "Cello": 1.0, "Pizzicato": 0.8, "Orchestra": 0.5 } },
    { "id": "brass",           "name": "Brass",               "classes": { "Brass instrument": 1.0, "Trumpet": 1.0, "Trombone": 1.0, "French horn": 1.0 } },
    { "id": "acoustic_other",  "name": "Acoustic instrument", "classes": { "Harp": 1.0, "Mandolin": 1.0, "Banjo": 1.0, "Ukulele": 1.0, "Sitar": 1.0, "Flute": 1.0, "Saxophone": 1.0, "Clarinet": 1.0, "Accordion": 1.0, "Harmonica": 1.0, "Bagpipes": 1.0, "Didgeridoo": 1.0 } }
  ],
  "refinements": {
    "distortionClass": "Distortion",
    "distortedGuitarScore": 0.20,
    "cleanGuitarScore": 0.06,
    "maleVocalMaxMedianHz": 165.0,
    "maleVocalMaxHighHz": 260.0,
    "femaleVocalMinMedianHz": 230.0,
    "femaleVocalMinLowHz": 160.0,
    "rackFloorTomSplitHz": 110.0,
    "synthBassMaxMedianHz": 140.0
  }
}
